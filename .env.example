# Runtime
HOTLINE_ENV=development
HOTLINE_HOST=127.0.0.1
HOTLINE_PORT=8787
HOTLINE_DATABASE_PATH=.hotline/hotline.db
HOTLINE_DAEMON_URL=http://127.0.0.1:8787
HOTLINE_TOOL_TOKEN=
# Development/demo escape hatch for Sarvam runtimes that reject Authorization
# headers. Production rejects false; local APIs and webhooks are unaffected.
HOTLINE_PUBLIC_TOOLS_REQUIRE_TOKEN=true
HOTLINE_LOCAL_TOKEN=
HOTLINE_CALLBACK_TOKEN=
HOTLINE_DECISION_TIMEOUT_SECONDS=600
HOTLINE_LOG_LEVEL=INFO
PUBLIC_BASE_URL=

# Optional missed-call fallback. Point this at an owner-controlled SMS/push bridge.
# The daemon sends a generic message plus a one-time fragment URL; no task context.
HOTLINE_FALLBACK_WEBHOOK_URL=
HOTLINE_FALLBACK_WEBHOOK_TOKEN=
HOTLINE_FALLBACK_TTL_SECONDS=900
HOTLINE_FALLBACK_MAX_PIN_ATTEMPTS=5

# Native Sarvam Samvaad / Vobiz
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
# Optional atomic JSON schedule. Omit/leave empty for Sarvam's 24/7 default.
# SARVAM_INBOUND_SCHEDULE={"start_time":"09:00","end_time":"18:00","allowed_days":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],"timezone":"Asia/Kolkata"}
OWNER_PHONE_NUMBER=

# Required for every decision outcome and action grant; 6-12 ASCII digits.
# Never put it in agent variables.
OWNER_CONFIRMATION_PIN=

# Codex deep integration
CODEX_BIN=codex
CODEX_APP_SERVER_ENABLED=true
CODEX_APP_SERVER_CWD=
# Semicolon-separated exact repository roots exposed to bounded context queries.
HOTLINE_WORKSPACE_ROOTS=
# Optional absolute trusted git executable; auto-discovery rejects repo-local binaries.
HOTLINE_GIT_BIN=

# Safety and demo behavior
HOTLINE_TRANSPORT=sarvam
HOTLINE_ALLOW_REAL_ACTIONS=false
HOTLINE_ALLOWLISTED_CALLERS=
HOTLINE_MAX_ACTIVE_CALLS=1
HOTLINE_RETRY_ATTEMPTS=2
