# Runtime
HOTLINE_ENV=development
HOTLINE_HOST=127.0.0.1
HOTLINE_PORT=8787
HOTLINE_DATABASE_PATH=.hotline/hotline.db
HOTLINE_DAEMON_URL=http://127.0.0.1:8787
HOTLINE_TRANSPORT=openai_realtime
HOTLINE_LOG_LEVEL=INFO

# Public HTTPS origin exposed to OpenAI and Twilio, without a trailing slash.
PUBLIC_BASE_URL=

# Independent local API and capability-signing secrets.
HOTLINE_LOCAL_TOKEN=
HOTLINE_SIP_CORRELATION_SECRET=
HOTLINE_ACTION_SIGNING_SECRET=
HOTLINE_FALLBACK_SIGNING_SECRET=

# OpenAI Realtime conversation runtime
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
OPENAI_PROJECT_ID=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_REASONING_EFFORT=low

# Twilio transports the phone leg only; OpenAI Realtime owns speech, reasoning,
# turn-taking, and function tools. Use `sip` for OpenAI SIP or `media_stream`
# for a direct bidirectional WebSocket bridge. Twilio trial accounts block both
# required custom carrier paths, so live PSTN Realtime calls need a paid carrier account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_BRIDGE_MODE=sip

# Owner identity and authority
OWNER_PHONE_NUMBER=
HOTLINE_OWNER_NAME=Owner
# Required for every authoritative voice decision, voice repository read, and action grant.
# Entered through DTMF and never spoken to or exposed to the model.
OWNER_CONFIRMATION_PIN=
HOTLINE_VOICE_PIN_MAX_ATTEMPTS=3
HOTLINE_ALLOWLISTED_CALLERS=

# Call behavior
HOTLINE_DECISION_TIMEOUT_SECONDS=600
HOTLINE_MAX_ACTIVE_CALLS=1
HOTLINE_MAX_CALL_DURATION_SECONDS=1800
HOTLINE_OUTBOUND_RING_TIMEOUT_SECONDS=30
HOTLINE_CARRIER_ADMISSION_TTL_SECONDS=300
HOTLINE_RETRY_ATTEMPTS=2

# Optional missed-call fallback. Point this at an owner-controlled SMS/push bridge.
# The daemon sends a generic message plus a one-time fragment URL; no task context.
HOTLINE_FALLBACK_WEBHOOK_URL=
HOTLINE_FALLBACK_WEBHOOK_TOKEN=
HOTLINE_FALLBACK_TTL_SECONDS=900
HOTLINE_FALLBACK_MAX_PIN_ATTEMPTS=5

# Codex deep integration
CODEX_BIN=codex
CODEX_APP_SERVER_ENABLED=true
CODEX_APP_SERVER_CWD=
# Semicolon-separated exact Git repository roots exposed to bounded task and
# repository queries. Production should always set this explicitly.
HOTLINE_WORKSPACE_ROOTS=
# Optional absolute trusted git executable; auto-discovery rejects repo-local binaries.
HOTLINE_GIT_BIN=

# Independent write gates. Built-in runbooks are mocks; no production
# infrastructure executor ships with this repository.
HOTLINE_ALLOW_CODEX_WRITES=false
HOTLINE_ALLOW_REAL_RUNBOOKS=false
